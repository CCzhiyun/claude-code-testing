{
  "name": "ccpt",
  "version": "0.72.0",
  "description": "CCPT enterprise multi-agent coding CLI",
  "type": "module",
  "bin": {
    "ccpt": "dist/cli.js",
    "ccpt-mcp": "dist/entrypoints/mcp.js"
  },
  "exports": {
    "./sdk": {
      "types": "./dist/types/src/entrypoints/sdk.d.ts",
      "import": "./dist/entrypoints/sdk.js"
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "check": "node --preserve-symlinks --preserve-symlinks-main ./node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test ./test",
    "coverage": "node ./scripts/generate-source-coverage.mjs && node ./scripts/generate-ui-compatibility-inventory.mjs && node ./scripts/generate-native-compatibility-inventory.mjs",
    "coverage:ui": "node ./scripts/generate-ui-compatibility-inventory.mjs",
    "coverage:native": "node ./scripts/generate-native-compatibility-inventory.mjs",
    "epics": "node ./scripts/generate-epic-enhancement-matrix.mjs",
    "pack:local": "npm pack",
    "pack:delivery": "npm run check && npm run build && node ./scripts/package-local.mjs --local-preview",
    "distribution:inventory": "node ./scripts/release-audit.mjs",
    "release:check": "node ./scripts/release-audit.mjs --check",
    "verify:package": "node ./scripts/verify-local-package.mjs",
    "prepublishOnly": "npm run release:check"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "vscode-extension"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "keywords": [
    "coding-agent",
    "multi-agent",
    "mcp",
    "cli"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "js-tiktoken": "1.0.21",
    "ws": "^8.18.0"
  },
  "bundleDependencies": [
    "ws",
    "js-tiktoken"
  ]
}
